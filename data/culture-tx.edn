#:culture{:id "phl.dish.adobo", :name "Philippine adobo", :country "PHL", :kind :dish, :summary "Often considered the unofficial national dish of the Philippines; the Spanish name was applied to an indigenous cooking method using vinegar that had developed independently in the archipelago.", :url "https://en.wikipedia.org/wiki/Philippine_adobo", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "phl.dish.sinigang", :name "Sinigang", :country "PHL", :kind :dish, :summary "Filipino soup or stew characterized by its sour and savory taste, typically soured with tamarind and served with rice.", :url "https://en.wikipedia.org/wiki/Sinigang", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "phl.dish.lechon", :name "Lechon", :country "PHL", :kind :dish, :summary "The Filipino lechon has pre-colonial origins and uses weaned pigs with native ingredients like lemongrass and tamarind, diverging from the Spanish suckling-pig tradition.", :url "https://en.wikipedia.org/wiki/Lechon", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "phl.dish.halo-halo", :name "Halo-halo", :country "PHL", :kind :dish, :summary "Popular cold dessert in the Philippines made with crushed ice, evaporated or coconut milk, and flavorings such as ube jam, beans and fruits, often topped with ice cream.", :url "https://en.wikipedia.org/wiki/Halo-halo", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:url "https://en.wikipedia.org/wiki/Tuba_(drink)", :id "phl.beverage.tuba", :kind :beverage, :name-local "Tubâ", :country "PHL", :retrieved-at "2026-07-17", :summary "Traditional Filipino palm wine made from the naturally fermented nectar of various species of palm trees, with an alcohol content of about 2-4%.", :name "Tuba", :url-provenance :wikipedia-en}
#:culture{:id "phl.craft.tnalak", :name "T'nalak", :country "PHL", :kind :craft, :summary "Weaving tradition of the T'boli people of South Cotabato, in which women who receive designs through dreams weave resist-dyed abaca cloth on a backstrap loom.", :url "https://en.wikipedia.org/wiki/T%27nalak", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "phl.craft.barong-tagalog", :name "Barong Tagalog", :country "PHL", :kind :craft, :summary "Embroidered long-sleeved formal shirt for men and a national dress of the Philippines, combining precolonial native Filipino and Spanish colonial clothing elements.", :url "https://en.wikipedia.org/wiki/Barong_Tagalog", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "phl.festival.sinulog-festival", :name "Sinulog Festival", :country "PHL", :kind :festival, :summary "Annual Filipino cultural and religious festival held on the third Sunday of January in Cebu, honoring the Santo Nino (Holy Child Jesus) and marking the Philippines' embrace of Christianity.", :url "https://en.wikipedia.org/wiki/Sinulog_Festival", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "phl.heritage.rice-terraces-cordilleras", :name "Rice Terraces of the Philippine Cordilleras", :country "PHL", :kind :heritage, :summary "Rice terraces built into the mountains of Ifugao, inscribed on the UNESCO World Heritage List in 1995 as the first property in the cultural landscape category.", :url "https://en.wikipedia.org/wiki/Rice_Terraces_of_the_Philippine_Cordilleras", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
